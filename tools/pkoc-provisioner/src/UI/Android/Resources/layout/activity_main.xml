<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/intro" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:padding="12dp"
        android:background="#22888888"
        android:textStyle="bold"
        android:text="@string/status_idle" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textStyle="bold"
        android:text="@string/key_header" />

    <RadioGroup
        android:id="@+id/keyModeGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
      <RadioButton
          android:id="@+id/keyDefault"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/key_default" />
      <RadioButton
          android:id="@+id/keySingle"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/key_single" />
      <RadioButton
          android:id="@+id/keySeparate"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:checked="true"
          android:text="@string/key_separate" />
    </RadioGroup>

    <!-- saveEnabled=false: keys are never persisted in instance state -->
    <EditText
        android:id="@+id/encKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/key_enc_hint"
        android:fontFamily="monospace"
        android:maxLength="47"
        android:saveEnabled="false"
        android:importantForAutofill="no"
        android:inputType="textVisiblePassword|textNoSuggestions" />
    <EditText
        android:id="@+id/macKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/key_mac_hint"
        android:fontFamily="monospace"
        android:maxLength="47"
        android:saveEnabled="false"
        android:importantForAutofill="no"
        android:inputType="textVisiblePassword|textNoSuggestions" />
    <EditText
        android:id="@+id/dekKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/key_dek_hint"
        android:fontFamily="monospace"
        android:maxLength="47"
        android:saveEnabled="false"
        android:importantForAutofill="no"
        android:inputType="textVisiblePassword|textNoSuggestions" />

    <TextView
        android:id="@+id/keyError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#D32F2F"
        android:visibility="gone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:text="@string/key_note" />

    <CheckBox
        android:id="@+id/replaceExisting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/replace_existing" />

    <TextView
        android:id="@+id/replaceWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#D32F2F"
        android:textSize="12sp"
        android:visibility="gone"
        android:text="@string/replace_warning" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">
      <Button
          android:id="@+id/analyzeButton"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="@string/analyze" />
      <Button
          android:id="@+id/installButton"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:layout_marginStart="8dp"
          android:text="@string/install" />
    </LinearLayout>

    <TextView
        android:id="@+id/logText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="monospace"
        android:textSize="12sp"
        android:textIsSelectable="true" />

  </LinearLayout>
</ScrollView>
