<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Not "CredBench.Android": that would shadow the Android.* binding namespaces -->
    <RootNamespace>CredBench.Droid</RootNamespace>
    <AssemblyName>CredBench.Droid</AssemblyName>
    <ApplicationId>com.zbitsystems.credbench</ApplicationId>
    <ApplicationTitle>Cred-Bench PKOC</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <!-- Sideloadable .apk rather than a Play Store .aab -->
    <AndroidPackageFormat Condition="'$(Configuration)' == 'Release'">apk</AndroidPackageFormat>
    <!-- Works around XAGNM7009 "missing native code generation state" in Release (Android SDK 36.1) -->
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Core.csproj" />
  </ItemGroup>

</Project>
